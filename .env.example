# FK Wallet bulut (Supabase) bağlantısı
#
# Bu dosyayı ".env.local" adıyla kopyalayıp değerleri doldurun.
# .env.local git'e gönderilmez (.gitignore içinde).
# Değişiklikten sonra "npx expo start" yeniden başlatılmalı (--clear ile).
#
# Değerleri Supabase panelinde: Project Settings > API bölümünde bulursunuz.
#   EXPO_PUBLIC_SUPABASE_URL              -> "Project URL"
#   EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY  -> "anon / publishable" anahtarı (gizli service_role DEĞİL)

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
